{
  "description": "Daily at midnight: marks active/paused specials past their end date as expired",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_expire_specials",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "expire": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "expireSpecials"
          },
          "then": "end",
          "x-base44": {
            "title": "Expire past specials",
            "description": "Marks specials past end date as expired"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 0 * * *",
      "one_time_date": null,
      "timezone": "Africa/Johannesburg",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Auto-Expire Specials"
}